{
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "type": "AdaptiveCard",
  "version": "1.4",
  "body": [
    {
      "type": "TextBlock",
      "text": "${temp}° ${sky}",
      "size": "ExtraLarge",
      "weight": "Bolder"
    },
    {
      "type": "TextBlock",
      "text": "Ressenti ${low}–${high}° · Vent ${wind_kmh} km/h",
      "isSubtle": true,
      "spacing": "None"
    },
    {
      "type": "TextBlock",
      "text": "Confiance ${confidence}% · ${stations} stations",
      "size": "Small",
      "isSubtle": true
    }
  ]
}
