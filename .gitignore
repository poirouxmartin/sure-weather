tools/
# Capacitor shell: build outputs, deps and generated native code stay out,
# but the hand-written widget sources + manifests are versioned.
app-android/*
!app-android/capacitor.config.json
!app-android/package.json
!app-android/android
app-android/android/*
!app-android/android/app
app-android/android/app/*
!app-android/android/app/src
app-android/android/app/src/*
!app-android/android/app/src/main
app-android/android/app/src/main/*
!app-android/android/app/src/main/AndroidManifest.xml
!app-android/android/app/src/main/java
!app-android/android/app/src/main/res
app-android/android/app/src/main/java/*
!app-android/android/app/src/main/java/com
app-android/android/app/src/main/java/com/*
!app-android/android/app/src/main/java/com/sureweather
app-android/android/app/src/main/java/com/sureweather/*
!app-android/android/app/src/main/java/com/sureweather/app
app-android/android/app/src/main/java/com/sureweather/app/*
!app-android/android/app/src/main/java/com/sureweather/app/WeatherWidget.java
app-android/android/app/src/main/res/*
!app-android/android/app/src/main/res/layout
!app-android/android/app/src/main/res/values
!app-android/android/app/src/main/res/xml
!app-android/android/app/src/main/res/drawable
app-android/android/app/src/main/res/layout/*
!app-android/android/app/src/main/res/layout/widget_weather.xml
app-android/android/app/src/main/res/values/*
!app-android/android/app/src/main/res/values/strings.xml
app-android/android/app/src/main/res/xml/*
!app-android/android/app/src/main/res/xml/weather_widget_info.xml
app-android/android/app/src/main/res/drawable/*
!app-android/android/app/src/main/res/drawable/widget_bg.xml
